---
import { howIBuild } from '../data/experience';

const amber = '#FFB000';
const mut = '#7E838B';
const txt = '#E4E2DC';
const flow = [
  { t: '// how a change gets to production', color: mut },
  { t: 'const draft = await agents.run(task, {', color: txt },
  { t: '  tools: ["claude", "codex", "mcp"],', color: txt },
  { t: '  for: ["implement", "refactor", "test",', color: txt },
  { t: '        "debug", "architecture"],', color: txt },
  { t: '});', color: txt },
  { t: '', color: txt },
  { t: 'const ok = await desire.review(draft);', color: amber },
  { t: 'if (ok) ship(draft); // and I own it after', color: txt },
];
---

<section id="how" class="section">
  <div class="grid">
    <div class="text">
      <h2>// how i build</h2>
      <p class="lede">AI-first. Human-reviewed. Owned by me.</p>
      <p>
        I use coding agents (Claude, Codex), MCP integrations, custom skills and multi-agent workflows for implementation,
        refactoring, testing, debugging and architecture analysis. They make me fast. They don't make the call. I review
        everything before it ships, and I own what happens after.
      </p>
      <ol>
        {howIBuild.map((t, i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span>{t}</span>
          </li>
        ))}
      </ol>
    </div>
    <figure>
      <figcaption><span>~/desire-kaleba/workflow.ts</span><span>the rule</span></figcaption>
      <div class="code">
        {flow.map((l, i) => (
          <div class="line"><span class="ln">{i + 1}</span><span class="src" style={`color:${l.color}`}>{l.t}</span></div>
        ))}
      </div>
    </figure>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    column-gap: 64px;
    row-gap: 32px;
    align-items: start;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h2 {
    font-family: var(--mono);
    font-size: 44px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .lede {
    font-family: var(--mono);
    font-size: 30px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .text > p {
    max-width: 62ch;
  }
  ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    max-width: 64ch;
  }
  li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  .n {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--link);
    padding-top: 3px;
  }
  figure {
    background: var(--night);
    color: var(--night-ink);
    border: 1px solid var(--code-edge);
    border-radius: 8px;
    overflow: hidden;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--night-rule);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--night-muted);
  }
  .code {
    padding: 16px 0;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.85;
    overflow-x: auto;
  }
  .line {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
  }
  .src {
    white-space: pre;
  }
  .ln {
    color: #5f646c;
    text-align: right;
    padding-right: 14px;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    h2 {
      font-size: 28px;
    }
    .lede {
      font-size: 22px;
    }
    .code {
      font-size: 12px;
    }
  }
</style>
