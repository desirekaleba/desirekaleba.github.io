---
import { credentials, experience } from '../data/experience';
---

<section id="exp" class="section">
  <div class="section-head">
    <h2>// git log --career</h2>
    <span>7 years in production · startups in the US, Canada, Europe, Israel and Africa</span>
  </div>
  <ol>
    {experience.map((e) => (
      <li>
        <span class="when">{e.when}</span>
        <span class:list={['dot', { current: e.current }]} aria-hidden="true" />
        <div class="body">
          <span class="role">
            {e.role} <span>@ {e.org}</span>
          </span>
          <span>{e.hi}</span>
          {e.facts && (
            <ul class="facts">
              {e.facts.map((f) => <li>{f}</li>)}
            </ul>
          )}
          {e.link && <a class="case" href={e.link}>my work there, as a case study →</a>}
        </div>
      </li>
    ))}
  </ol>
  <div class="creds">
    {credentials.map((c) => <span>{c}</span>)}
  </div>
</section>

<style>
  ol {
    list-style: none;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 200px 11px minmax(0, 1fr);
    column-gap: 24px;
    row-gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .when {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--muted);
    align-self: center;
  }
  .dot.current {
    border-color: var(--amber);
    background: var(--amber);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 16px;
    max-width: 80ch;
  }
  .role {
    font-family: var(--mono);
    font-weight: 700;
  }
  .role span {
    font-weight: 400;
    color: var(--muted);
  }
  .facts {
    list-style: none;
    padding: 0;
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--mono);
    font-size: 13px;
  }
  .facts li {
    display: block;
    padding: 2px 10px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--ink);
  }
  .case {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
  }
  .creds {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding-top: 18px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    li {
      grid-template-columns: 1fr 11px;
    }
    .body {
      grid-column: 1 / -1;
    }
  }
</style>
