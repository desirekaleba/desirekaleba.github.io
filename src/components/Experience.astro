---
import { credentials, experience } from '../data/experience';
---

<section id="exp" class="section">
  <div class="section-head">
    <h2>// git log --career</h2>
    <span>6+ years in production · startups in the US, Canada, Europe, Israel and Africa</span>
  </div>
  <ol>
    {experience.map((e) => (
      <li>
        <span class="when">{e.when}</span>
        <span class:list={['dot', { current: e.current }]} aria-hidden="true" />
        <div class="body">
          <span class="role">
            {e.role} <span>@ {e.org}</span>
          </span>
          <span>{e.hi}</span>
        </div>
      </li>
    ))}
  </ol>
  <div class="creds">
    {credentials.map((c) => <span>{c}</span>)}
  </div>
</section>

<style>
  ol {
    list-style: none;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 200px 11px minmax(0, 1fr);
    column-gap: 24px;
    row-gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .when {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--muted);
    align-self: center;
  }
  .dot.current {
    border-color: var(--amber);
    background: var(--amber);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 16px;
  }
  .role {
    font-family: var(--mono);
    font-weight: 700;
  }
  .role span {
    font-weight: 400;
    color: var(--muted);
  }
  .creds {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding-top: 18px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    li {
      grid-template-columns: 1fr 11px;
    }
    .body {
      grid-column: 1 / -1;
    }
  }
</style>
