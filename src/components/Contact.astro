---
import { site } from '../data/site';
---

<section id="contact" class="contact">
  <div class="inner">
    <span class="label">// contact. email works best.</span>
    <a href={`mailto:${site.email}`} class="mail">{site.email}</a>
    <div class="links">
      <a href={site.github}>github.com/desirekaleba ↗</a>
      <a href={site.linkedin}>linkedin ↗</a>
      <a href={site.resume}>resume.pdf</a>
    </div>
    <span class="where">{site.location} · UTC+3 · working remotely, open to roles anywhere · {site.languages.join(', ')}</span>
  </div>
  <footer>
    <span>© {new Date().getFullYear()} Desire Kaleba</span>
    <span>Built with Astro. The board is three.js.</span>
  </footer>
</section>

<style>
  .contact {
    padding: 96px var(--side) 40px;
    background: var(--night);
    color: #ecedee;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .label {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--night-muted);
  }
  .mail {
    font-family: var(--mono);
    font-size: clamp(30px, 5.3vw, 76px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--amber);
    text-underline-offset: 8px;
    text-decoration-thickness: 3px;
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 600;
  }
  .links a {
    color: #ecedee;
  }
  .where {
    font-size: 16px;
    color: #b5b8be;
  }
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 64px;
    padding-top: 18px;
    border-top: 1px solid var(--night-rule);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--night-muted);
  }
  @media (max-width: 760px) {
    .contact {
      padding: 56px var(--side) 40px;
    }
  }
</style>
