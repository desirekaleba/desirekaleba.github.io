---
import Base from '../../layouts/Base.astro';
import Flaps from '../../components/Flaps.astro';
import Diagram from '../../components/Diagram.astro';
import { caseStudies, getCase, type CaseStudy } from '../../data/work';
import { site } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: CaseStudy };
const next = getCase(c.next)!;
// Only sections with content are shown, numbered in order.
const sections = c.sections.filter((s) => s.paras?.length || s.bullets?.length || s.decisions?.length || s.numbers?.length);
---

<Base title={`${c.name} · case study · Desire Kaleba`} description={c.description}>
  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">~/desire-kaleba</a><span>/</span><a href="/#work">work</a><span>/</span><span class="here" aria-current="page">{c.slug}</span>
  </nav>

  <section class="top">
    <span class="kind">case study · {c.kind}</span>
    <h1 class="sr-only">{c.name}: case study</h1>
    <Flaps word={c.slug} class="big-flaps" />
    <p class="one-line">{c.oneLine}</p>
    <dl class="meta">
      {c.meta.map((m) => (
        <div>
          <dt>{m.k}</dt>
          <dd>{m.v}</dd>
        </div>
      ))}
    </dl>
    <div class="ext">
      {c.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <div class="numbers">
      {c.numbers.map((n) => (
        <div>
          <span class="v">{n.v}</span>
          <span class="k">{n.k}</span>
        </div>
      ))}
    </div>
  </section>

  {sections.map((sec, i) => (
    <section class="sec">
      <div class="sec-head">
        <span>{String(i + 1).padStart(2, '0')}</span>
        <h2>{sec.title}</h2>
      </div>
      <div class="sec-body">
        {sec.paras?.map((p) => <p>{p}</p>)}
        {sec.bullets && (
          <ul class="bullets">
            {sec.bullets.map((b) => <li><span aria-hidden="true">+</span><span>{b}</span></li>)}
          </ul>
        )}
        {sec.decisions && (
          <ol class="decisions">
            {sec.decisions.map((d) => (
              <li>
                <span class="dt">{d.t}</span>
                <span>{d.d}</span>
              </li>
            ))}
          </ol>
        )}
        {sec.diagram && <Diagram title={c.diagram.title} note={c.diagram.note} nodes={c.diagram.nodes} />}
        {sec.numbers && (
          <div class="tiles">
            {sec.numbers.map((n) => (
              <div>
                <span class="v">{n.v}</span>
                <span class="k">{n.k}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="end">
    <a href={`/work/${next.slug}`} class="next">
      <span>next case study</span>
      <span class="big">{next.name} →</span>
    </a>
    <a href={`mailto:${site.email}`} class="talk">
      <span>want to talk about it?</span>
      <span class="big">{site.email}</span>
    </a>
  </section>
  <footer class="foot">
    <span>© {new Date().getFullYear()} Desire Kaleba · Nairobi</span>
    <a href="/">← back to ~/desire-kaleba</a>
  </footer>
</Base>

<style>
  .crumbs {
    padding: 18px var(--side) 0;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .crumbs a {
    color: var(--ink);
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .crumbs span {
    color: var(--muted);
  }
  .crumbs .here {
    color: var(--link);
  }
  .top {
    padding: 56px var(--side) 64px;
    display: flex;
    flex-direction: column;
    gap: 26px;
    border-bottom: 1px solid var(--rule);
  }
  .kind {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .top :global(.big-flaps) {
    --flap-w: 64px;
    --flap-h: 92px;
    --flap-f: 48px;
    --flap-gap: 5px;
  }
  .one-line {
    font-family: var(--mono);
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 30ch;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 32px;
    font-family: var(--mono);
    font-size: 14px;
    max-width: 980px;
  }
  .meta div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    column-gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }
  .meta dt {
    color: var(--muted);
  }
  .meta dd {
    font-weight: 600;
  }
  .ext {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
  }
  .numbers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding-top: 8px;
  }
  .numbers div {
    border-top: 2px solid var(--ink);
    padding-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .numbers .v {
    font-family: var(--mono);
    font-size: 56px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .numbers .k,
  .tiles .k {
    font-size: 15px;
    color: var(--muted);
  }
  .sec {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    column-gap: 48px;
    row-gap: 14px;
    padding: 64px var(--side);
    border-bottom: 1px solid var(--rule);
  }
  .sec-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--mono);
  }
  .sec-head span {
    font-size: 13px;
    color: var(--link);
  }
  .sec-head h2 {
    font-size: 26px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .sec-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 70ch;
    line-height: 1.65;
  }
  .bullets {
    list-style: none;
    padding: 0;
  }
  .bullets li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }
  .bullets li > span:first-child {
    font-family: var(--mono);
    color: var(--link);
  }
  .decisions {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .decisions li {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 16px;
  }
  .decisions .dt {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 700;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .tiles div {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tiles .v {
    font-family: var(--mono);
    font-size: 28px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .end {
    padding: 64px var(--side);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .end a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    border-radius: 8px;
    text-decoration: none;
    font-family: var(--mono);
  }
  .end a > span:first-child {
    font-size: 12px;
  }
  .next {
    border: 1px solid var(--ink);
    color: var(--ink);
  }
  .next > span:first-child {
    color: var(--muted);
  }
  .talk {
    background: var(--night);
    color: #ecedee;
  }
  .talk > span:first-child {
    color: var(--night-muted);
  }
  .big {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .talk .big {
    color: var(--amber);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 18px var(--side) 32px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid var(--rule);
  }
  .foot a {
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .sec {
      grid-template-columns: minmax(0, 1fr);
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .top {
      padding: 40px var(--side);
    }
    .top :global(.big-flaps) {
      --flap-w: 26px;
      --flap-h: 38px;
      --flap-f: 19px;
      --flap-gap: 3px;
    }
    .one-line {
      font-size: 24px;
    }
    .meta,
    .numbers {
      grid-template-columns: minmax(0, 1fr);
    }
    .numbers .v {
      font-size: 34px;
    }
    .sec {
      padding: 40px var(--side);
    }
    .sec-head h2 {
      font-size: 22px;
    }
    .end {
      grid-template-columns: minmax(0, 1fr);
      padding: 40px var(--side);
    }
    .big {
      font-size: 20px;
    }
  }
</style>
